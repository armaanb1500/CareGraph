# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your key stays on your machine.

# Which LLM backend to use: "gemini" for now, "ollama" later.
LLM_PROVIDER=gemini

# Get a free key at https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=paste-your-key-here

# The Gemini model to call. scripts/check_setup.py tells you if it's unavailable.
GEMINI_MODEL=gemini-3.8-flash

# Tried in order when GEMINI_MODEL is overloaded (common on the free tier). Comma-separated.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
